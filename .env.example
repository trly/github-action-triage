# GitHub Action Triage - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# Required Configuration
# ============================================================================

# GitHub App credentials (required for webhook verification and API access)
TRIAGE_GITHUB_APP_ID=your-github-app-id
TRIAGE_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour private key here\n-----END RSA PRIVATE KEY-----"
TRIAGE_GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Anthropic API key (required for AI analysis)
TRIAGE_ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================================================
# Optional Configuration
# ============================================================================

# Sourcegraph Deep Search Integration (optional - enables advanced code analysis)
# Get your token from: https://sourcegraph.com/user/settings/tokens
TRIAGE_SOURCEGRAPH_TOKEN=sgp_your_token_here
TRIAGE_SOURCEGRAPH_URL=https://sourcegraph.com

# Redis Configuration (defaults to redis://localhost:6379/0)
TRIAGE_REDIS_URL=redis://localhost:6379/0

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRIAGE_LOG_LEVEL=INFO

# Testing: Disable GitHub issue creation (logs proposals instead)
TRIAGE_DISABLE_ISSUE_CREATION=false

# TriageAgent (pydantic-ai) Analysis Configuration
TRIAGE_ANALYSIS_MODEL=anthropic:claude-sonnet-4-5
TRIAGE_ANALYSIS_TIMEOUT_SECONDS=300

# ============================================================================
# Legacy Configuration (for backward compatibility with old RemediationAgent)
# ============================================================================

# DEPRECATED: Use TRIAGE_ANALYSIS_MODEL instead
# TRIAGE_CLAUDE_MODEL=claude-sonnet-4-20250514

# DEPRECATED: Use TRIAGE_ANALYSIS_TIMEOUT_SECONDS instead  
# TRIAGE_CLAUDE_MAX_TURNS=6
